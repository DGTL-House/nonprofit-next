---
import { BOOK_CALL, CTA_PRIMARY } from "../consts";

const assurances = ["100% free", "30 minutes", "Google for Nonprofits Partner"];
---

<!-- Block 8 — Final CTA -->
<section class="relative py-16 sm:py-24 overflow-hidden bg-[#f0eee6]/70">
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[480px] bg-[#aac976]/15 rounded-full blur-[170px] pointer-events-none"
  >
  </div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <div class="reveal">
      <!-- #book anchor lives here so CTAs land right on the final offer, just
           below the header, instead of deep inside the section. -->
      <div id="book" class="scroll-mt-4 sm:scroll-mt-6"></div>

      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#161514] leading-tight mb-4"
      >
        Ready to see what's holding your Google Ad Grant{" "}
        <span class="gradient-text-lime">back?</span>
      </h2>
      <p class="text-[#52504c] text-base sm:text-xl">
        Book a free 30-minute consultation with a Google Ad Grants specialist.
      </p>
      <p class="text-[#161514] text-base sm:text-xl font-semibold mt-2">
        No prep. No credit card. No commitment.
      </p>

      <a
        href={BOOK_CALL}
        class="btn-primary attention-pulse mt-8 sm:mt-10 text-base sm:text-2xl !py-3.5 sm:!py-5 !px-8 sm:!px-12"
      >
        {CTA_PRIMARY} →
      </a>

      <ul
        class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[#52504c] text-sm sm:text-base font-medium"
      >
        {
          assurances.map((a) => (
            <li class="inline-flex items-center gap-1.5">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#3f5028"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {a}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

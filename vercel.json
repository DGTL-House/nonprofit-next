{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//": "Vercel merges every matching rule and lets later ones win on duplicate keys, so these run general -> specific.",
  "headers": [
    {
      "//": "Baseline: security headers everywhere, plus the HTML policy. Browsers always revalidate; the edge holds a copy so x-vercel-cache reports HIT instead of MISS on each visit. A deploy purges the edge, so content still ships immediately.",
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=31536000, stale-while-revalidate=31536000"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "//": "Unhashed media: a week in the browser, a year on the edge.",
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "//": "Self-hosted variable font — one file, never edited in place.",
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "//": "Astro emits content-hashed filenames here — safe to freeze forever.",
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
